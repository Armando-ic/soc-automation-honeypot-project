# Secrets file — contains API keys, VM passwords, DFIR-Iris admin password
SOC-Automation-Project.md

# Per-branch / per-component local secrets files (e.g. v2-azure/secrets.local.md)
# Documented in the file headers themselves as gitignored — this pattern enforces that contract.
*.local.md

# Obsidian local config (per-machine, no need to share)
vault/.obsidian/
vault/.trash/

# Local environment files (when we eventually migrate secrets here)
.env
.env.local
*.env

# Vendored third-party Splunk MCP (kept on disk for local dev; referenced by upstream URL in README — not redistributed in this repo)
splunk-mcp-main/

# Python bytecode under scripts/
scripts/__pycache__/

# Locally-downloaded tooling archives (ART zip, etc.) — fetched on demand, not vendored
downloads/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/

# Claude Code session metadata + per-instance context file (workspace-only, not for public repo)
.claude/
CLAUDE.md
scratch/


# Local-only working folder (handoff notes, scratch, VM login secrets) — never publish
Personal/

# Playwright MCP working dir (per-machine, not for the repo)
.playwright-mcp/

# Python bytecode anywhere (generalizes the earlier scripts/__pycache__/ rule)
__pycache__/
