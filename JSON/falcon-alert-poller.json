      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://grounding-service:8000/falcon/state",
        "options": {}
      },
      "id": "get_state",
      "name": "get_state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.us-2.crowdstrike.com/alerts/queries/alerts/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "crowdStrikeOAuth2Api",
        "options": {},
