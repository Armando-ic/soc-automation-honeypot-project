          ]
        }
      },
      "id": "falcon_query",
      "name": "falcon_query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        0
      ],
      "credentials": {
        "crowdStrikeOAuth2Api": {
          "id": "REPLACE_ME",
