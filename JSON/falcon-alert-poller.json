            "index": 0
          }
        ]
      ]
    },
    "Post+Collect": {
      "main": [
        [
          {
            "node": "falcon_advance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
